/*
 * レシピを選ぶ板。起動したらレシピの板の場所にこれが出る。
 * 3列のグリッド・上に写真・下に題名と「25分 ・ 中華 ・ 620kcal」。押す的はカード全体。
 *
 * 写真は RecipeStore 越しにローカルから読む（オフライン前提）。手元に無ければその場で
 * 取りに行き、取れなければチップ色の下地に「写真なし」のまま。
 */

.recipe-list-header {
    flex-shrink: 0;
}

.recipe-list-status {
    margin-top: 2px;
}

/* グリッドの置き場を稼ぐため、頭まわりの余白は詰める。 */
.recipe-list-divider {
    margin-top: 2px;
    margin-bottom: 2px;
}

.recipe-list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

/* 中身を3列に折り返す（ScrollView が自分で作る容れ物へ当てる）。 */
.recipe-list-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.recipe-list-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

/*
 * カード1枚（＝押す的）。幅は 1/3 ずつ。外側に余白（padding）を持たせて、
 * 隣のカードとの隙間ぶんも的に含める——指で狙う的は大きいほうがよい。
 */
.recipe-card {
    width: 33.33%;
    padding: 2px;
    flex-shrink: 0;
}

/* 見た目の本体（角丸と地の色はこちら。的は外側）。 */
.recipe-card__body {
    background-color: var(--color-chip-bg);
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    overflow: hidden;
    padding-bottom: 2px;
}

/* 同梱の見本。manor が無くても必ず並ぶので、少しだけ色を変えて区別する。 */
.recipe-card--sample .recipe-card__body {
    background-color: var(--color-chip-bg-strong);
}

/*
 * 写真。板の幅 260px・3列なのでカードの中身は ≒ 69px 幅。高さは 34px（約 2:1）。
 * 16:10（≒43px）にすると 2 段目（4〜6 件目）が表示領域から 7px はみ出すので、
 * 「6 件までは縦スクロール無し」を優先して切り詰めた。
 * cover なので元の 1200×630 は中央で切られる。
 */
.recipe-card__photo {
    height: 34px;
    background-color: var(--color-chip-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* まだ取れていない／URL が無いときの札。写真が入ったら C# が消す。 */
.recipe-card__no-photo {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    margin: 0px;
    padding: 0px;
}

/*
 * 題名は1〜2行で省略（3行目からは切る）。高さを 2 行ぶんで固定するのは、
 * 題名の長さでカードの背丈が揃わなくなると格子が崩れて見えるため。
 */
.recipe-card__title {
    font-size: var(--font-size-body);
    color: var(--color-text);
    white-space: normal;
    overflow: hidden;
    height: 17px;
    padding: 0px;
    margin: 0px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 2px;
}

.recipe-card__detail {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    padding: 0px;
    margin: 0px;
    margin-left: 3px;
    margin-right: 3px;
}

/* 空のときの札（「manor 未設定（見本だけ）」など）。折り返しの列に混ざらないよう幅いっぱい。 */
.recipe-list-empty {
    width: 100%;
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 0px;
    margin: 0px;
    margin-top: 10px;
}

/* 「準備中 n/m」。押せる的を覆い隠して二重の選択を防ぐ。 */
.recipe-list-busy {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.92);
    border-top-left-radius: var(--radius-large);
    border-top-right-radius: var(--radius-large);
    border-bottom-left-radius: var(--radius-large);
    border-bottom-right-radius: var(--radius-large);
}

/*
 * ペアリングの6桁。覆いの中に出す。
 *
 * 20px は実寸 4cm（theme.uss の換算: 1 UI px ≒ 2mm）——調理台から少し離れていても、
 * ヘッドセットを外さずに読み上げられる大きさ。字間を空けるのは
 * 6桁を2つ3つに区切って読み違えないため。文字の大きさの設定（font-scale--*）には従わない
 * ——ここは「読めること」が用途なので、小さくされると困る。
 */
.recipe-pair-code {
    font-size: 20px;
    letter-spacing: 4px;
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 4px;
}

/* 「manor の 設定 → 端末 に入れて許可してください」。折り返して板の幅に収める。 */
.recipe-pair-hint {
    width: 90%;
    color: var(--color-text-muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* 頭は横1列: [レシピ帳][設定][配置]。「配置」は2度押し。 */
.recipe-list-header-row {
    flex-direction: row;
    align-items: center;
}

.recipe-list-title {
    flex-grow: 1;
    flex-shrink: 1;
}

/* 頭の釦は縦の余白を詰める（グリッドの置き場を1行ぶん稼ぐため）。 */
.recipe-list-header-row .kitchen-button {
    margin-top: 0px;
    margin-bottom: 0px;
}

.recipe-settings-open-button {
    flex-shrink: 0;
    min-width: 24px;
}

.recipe-place-button {
    flex-shrink: 0;
    min-width: 24px;
    margin-right: 0px;
}

.recipe-place-button--armed {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
}

/*
 * 表示の設定。一覧と入れ替わりで出る（別の板を作らない——設定のためだけに板が増えると、
 * 置き場所を覚える対象も増えてしまう）。押した瞬間に反映して保存する。
 */
.recipe-settings-section {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.recipe-settings-caption {
    margin-top: 4px;
    margin-bottom: 1px;
}

.recipe-settings-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* 3つの段の釦。今の値だけ primary（琥珀）になる（C# が付け替える）。 */
.recipe-settings-option {
    flex-grow: 1;
    flex-shrink: 0;
    margin-left: 0px;
    margin-right: var(--gap-loose);
}

.recipe-settings-spacer {
    flex-grow: 1;
}

.recipe-settings-close {
    flex-shrink: 0;
    align-self: flex-start;
    min-width: 40px;
    margin-left: 0px;
}
