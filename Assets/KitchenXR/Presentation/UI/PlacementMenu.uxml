<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="theme.uss" />
    <ui:Style src="PlacementMenu.uss" />
    <ui:VisualElement name="root" class="root-panel placement-menu-root">
        <ui:Label name="hintLabel" text="板を掴んで動かし、終わったら「保存」" class="caption placement-menu-hint" />
        <ui:VisualElement name="idleGroup" class="placement-menu-row">
            <ui:Button name="placementButton" text="配置" class="kitchen-button kitchen-button--primary placement-menu-button" />
        </ui:VisualElement>
        <ui:VisualElement name="placingGroup" class="placement-menu-group">
            <ui:VisualElement class="placement-menu-row">
                <ui:Button name="saveButton" text="保存" class="kitchen-button kitchen-button--primary placement-menu-button" />
                <ui:Button name="undoButton" text="元に戻す" class="kitchen-button kitchen-button--secondary placement-menu-button" />
            </ui:VisualElement>
            <ui:VisualElement class="placement-menu-row">
                <ui:Button name="recallButton" text="板を手元に" class="kitchen-button kitchen-button--secondary placement-menu-button" />
                <ui:Button name="cancelButton" text="やめる" class="kitchen-button kitchen-button--secondary placement-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
