<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="theme.uss" />
    <ui:Style src="RecipeListPanel.uss" />
    <ui:VisualElement name="root" class="root-panel">
        <ui:VisualElement name="listHeader" class="recipe-list-header">
            <ui:VisualElement class="recipe-list-header-row">
                <ui:Label text="レシピ帳" class="heading recipe-list-title" />
                <ui:Button name="settingsButton" text="設定" class="kitchen-button kitchen-button--secondary recipe-settings-open-button" />
                <ui:Button name="placementButton" text="配置" class="kitchen-button kitchen-button--secondary recipe-place-button" />
            </ui:VisualElement>
            <ui:Label name="statusLabel" text="" class="caption recipe-list-status" />
        </ui:VisualElement>
        <ui:VisualElement class="divider recipe-list-divider" />
        <ui:ScrollView name="recipeScroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="recipe-list-scroll" />
        <ui:VisualElement name="settingsSection" class="recipe-settings-section is-hidden">
            <ui:Label text="文字の大きさ" class="caption recipe-settings-caption" />
            <ui:VisualElement class="recipe-settings-row">
                <ui:Button name="fontSmallButton" text="小" class="kitchen-button kitchen-button--secondary recipe-settings-option" />
                <ui:Button name="fontMediumButton" text="中" class="kitchen-button kitchen-button--secondary recipe-settings-option" />
                <ui:Button name="fontLargeButton" text="大" class="kitchen-button kitchen-button--secondary recipe-settings-option" />
            </ui:VisualElement>
            <ui:Label text="板の大きさ" class="caption recipe-settings-caption" />
            <ui:VisualElement class="recipe-settings-row">
                <ui:Button name="panelSmallButton" text="小" class="kitchen-button kitchen-button--secondary recipe-settings-option" />
                <ui:Button name="panelMediumButton" text="中" class="kitchen-button kitchen-button--secondary recipe-settings-option" />
                <ui:Button name="panelLargeButton" text="大" class="kitchen-button kitchen-button--secondary recipe-settings-option" />
            </ui:VisualElement>
            <ui:VisualElement class="recipe-settings-spacer" />
            <ui:Button name="settingsCloseButton" text="閉じる" class="kitchen-button kitchen-button--secondary recipe-settings-close" />
        </ui:VisualElement>
        <ui:VisualElement name="busySection" class="recipe-list-busy is-hidden">
            <ui:Label name="busyLabel" text="準備中" class="heading" />
            <!-- ペアリングの番号（manor の ADR-017 D2）。板に文字入力を置かないので、
                 番号はこちらに出して主人が manor の Web に入れる。6桁は離れた所からでも
                 読めるよう専用のクラスで大きく出す。 -->
            <ui:Label name="pairCodeLabel" text="" class="recipe-pair-code is-hidden" />
            <ui:Label name="pairHintLabel" text="" class="caption recipe-pair-hint is-hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
