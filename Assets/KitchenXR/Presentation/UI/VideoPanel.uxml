<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="theme.uss" />
    <ui:Style src="VideoPanel.uss" />
    <ui:VisualElement name="root" class="root-panel video-panel">
        <ui:VisualElement name="mainRow" class="video-main-row">
            <ui:VisualElement name="videoArea" class="video-area">
                <ui:Label name="editorNotice" text="動画は実機で（Quest 3）" picking-mode="Ignore" class="caption video-notice" />
            </ui:VisualElement>
            <ui:VisualElement name="listBlock" class="video-block video-list-block">
                <ui:VisualElement name="cameraWindow" picking-mode="Ignore" class="video-camera-window is-hidden" />
                <ui:Label name="cameraStatus" text="" picking-mode="Ignore" class="caption video-camera-status is-hidden" />
                <ui:VisualElement name="cameraRow" class="video-camera-row">
                    <ui:Button name="cameraButton" text="カメラ" class="kitchen-button kitchen-button--secondary video-camera-button" />
                    <ui:Button name="cameraBurstButton" text="連写2fps" class="kitchen-button kitchen-button--secondary video-camera-button" />
                </ui:VisualElement>
                <ui:Label name="listTitle" text="再生リスト" picking-mode="Ignore" class="caption video-list-title" />
                <ui:ScrollView name="mediaList" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="video-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="controlBlock" class="video-block">
            <ui:VisualElement name="statusRow" class="video-status-row">
                <ui:Label name="nowPlayingLabel" text="—" class="caption video-now-playing" />
                <ui:Label name="volumeLabel" text="音量 70" class="caption" />
            </ui:VisualElement>
            <ui:Label name="statusLine" text="" class="caption video-status-line" />
            <ui:Label name="actionLine" text="" class="caption video-status-line" />
            <ui:Label name="errorLine" text="" class="caption video-status-line video-status-line--error is-hidden" />
            <ui:VisualElement name="buttonRow" class="video-button-row">
                <ui:Button name="playPauseButton" text="再生" class="kitchen-button kitchen-button--primary" />
                <ui:Button name="volumeDownButton" text="−" class="kitchen-button kitchen-button--secondary" />
                <ui:Button name="volumeUpButton" text="＋" class="kitchen-button kitchen-button--secondary" />
                <ui:Button name="aspectButton" text="9:16" class="kitchen-button kitchen-button--secondary" />
                <ui:Button name="backButton" text="戻る" class="kitchen-button kitchen-button--secondary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
