/*
 * 動画の板（設計 §6・§9・ROADMAP P4）。色と寸法の元は theme.uss（1 UI px = 2mm）。
 *
 * 上から: 題名の列（縦・最大8件）／動画の窓／今見ているもの＋音量／ボタンの行。
 * **文字入力は置かない**（設計 §6）——URL を打つ欄はここに無い。
 *
 * 動画の窓（.video-area）には UI Toolkit では何も描かない。
 * 実際の絵は主人の YoutubePlayer プレハブの RawImage が、この窓のすぐ手前（0.6mm）に重なる
 * （VideoPanel.LayoutSurface）。ここで描いているのは Editor 用の「動画は実機で」の札と、
 * 実機で読み込み待ちのときに透けて見える下地だけ。
 */

.video-panel {
    /* 娯楽の板なので、レシピの板より少しだけ落ち着かせる（強調色は使わない）。 */
}

/* --- 題名の列（縦。最大8件。溢れたら縦スクロール） --- */

.video-list {
    height: 60px; /* ≒ 12cm。行を高くしたので4件。溢れたら縦スクロール。 */
    flex-shrink: 0;
    overflow: hidden;
}

.video-row {
    flex-direction: row;
    align-items: center;
    /* 2026-09-13 実機: 一覧の行が押せなかった。行が 1.6cm では指先の当たりに対して薄すぎるので
     * 2.8cm へ（ボタンの最小 4cm には届かないが、行は縦に並ぶので間隔は取れる）。 */
    min-height: 14px;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-bottom: 1px;
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    background-color: var(--color-chip-bg);
    overflow: hidden;
    flex-shrink: 0;
}

/* 今選んでいるもの。 */
.video-row--selected {
    background-color: var(--color-chip-bg-strong);
}

.video-row__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--font-size-ingredient);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- 動画の窓 --- */

.video-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(31, 41, 55, 0.85);
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    overflow: hidden;
}

.video-notice {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--font-size-body);
    -unity-text-align: middle-center;
}

/* --- 今見ているもの・音量 --- */

.video-status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 1px;
}

.video-now-playing {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 4px;
}

/* --- ボタンの行（設計 §7: 最小4cm角・間隔2cm。狭い向きでも折り返して隠れない） --- */

.video-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* --- 中の様子の札（2026-09-13 主人「エラーや失敗時にどこかに表示してほしい」） ---
 * 1行目: WebView／HTML／プレイヤーの状態。2行目: 最後に板がしたこと。3行目: 最後の失敗（赤）。 */

.video-status-line {
    white-space: normal;
    flex-shrink: 0;
    overflow: hidden;
    margin-bottom: 0.5px;
}

.video-status-line--error {
    color: var(--color-alarm);
}
