/*
 * 材料の板。
 * 横スクロールは出さない——行は板の幅に収め、溢れた文字は「…」で切る。縦だけスクロールする。
 */

.ingredients-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* 横に溢れたぶんは見せない（横スクロールバーを出さない）。 */
.ingredients-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.ingredients-scroll .unity-scroll-view__content-container {
    flex-shrink: 0;
}
