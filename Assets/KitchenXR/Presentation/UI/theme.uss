/*
 * KitchenXR 共通テーマ。
 * 白 85% の半透明の板・濃灰の文字・琥珀の強調色1色。角丸は大きめ。Unity既定の見た目は使わない。
 *
 * 実寸の換算: PanelSettings の Pixels Per Unit = 100、板の localScale = 0.2 なので
 * 1 UI px = 2mm（20px = 4cm・10px = 2cm）。「最小4cm角・間隔2cm」はこの換算の数値。
 *
 * 同じ罠を踏まないこと:
 *   1) `-unity-font-definition` は UnityEngine.TextCore.Text.FontAsset しか受け付けない。
 *      TMPro.TMP_FontAsset を指すと型が合わず、指定ごと無視されて文字が1つも描かれない。
 *   2) 長さには必ず単位（px）を付ける。単位無しの値は `var()` 越しに `font-size` へ渡すと
 *      型が合わず無視され、既定の 14px に戻ってしまう。
 */

:root {
    --color-panel-bg: rgba(255, 255, 255, 0.85);
    --color-text: rgb(31, 41, 55);
    --color-text-muted: rgba(31, 41, 55, 0.55);
    --color-accent: rgb(245, 158, 11);
    --color-accent-text: rgb(255, 255, 255);
    --color-divider: rgba(31, 41, 55, 0.15);
    --color-chip-bg: rgba(31, 41, 55, 0.08);
    --color-chip-bg-strong: rgba(245, 158, 11, 0.18);
    --color-alarm: rgb(220, 38, 38);
    --color-alarm-bg: rgba(220, 38, 38, 0.22);

    /* 文字3段（見出し／本文／補助）。48/32/24pt の比を保った実機換算値（上のコメント参照）。
     * 材料の板はさらに一段小さい --font-size-ingredient を使う。 */
    --font-size-heading: 10px;
    --font-size-body: 6px;
    --font-size-caption: 5px;
    --font-size-ingredient: 5.5px;

    --radius-large: 12px;
    --radius-medium: 6px;

    /* ボタン: 最小4cm角 = 20px、間隔2cm = 10px。
     * ボタンの余白は上下左右 5px（＝隣り合うボタンの間が 10px = 2cm）。
     * これ以上広げると本文の置き場を圧迫する。 */
    --button-min: 20px;
    --gap-loose: 10px;
    --gap-tight: 5px;
}

/*
 * 文字の大きさの3段。
 * <see cref="KitchenXR.Presentation.DisplaySettingsApplier"/> が各板の `.root-panel` に
 * このクラスを付け外しする。中はクラス無し（上の :root の値のまま）。
 *
 * :root ではなく板の根に置くのが肝心。カスタムプロパティは継承するので、
 * 板の根で上書きすれば中の全ての要素（ボタン・材料の行も）が一緒に動く。
 * 板ごとに別の大きさにしたくなったときも、ここを触らずに済む。
 */
.font-scale--small {
    --font-size-heading: 8.5px;
    --font-size-body: 5px;
    --font-size-caption: 4.25px;
    --font-size-ingredient: 4.75px;
}

.font-scale--large {
    --font-size-heading: 12.5px;
    --font-size-body: 7.5px;
    --font-size-caption: 6.25px;
    --font-size-ingredient: 7px;
}

.root-panel {
    flex-grow: 1;
    background-color: var(--color-panel-bg);
    border-top-left-radius: var(--radius-large);
    border-top-right-radius: var(--radius-large);
    border-bottom-left-radius: var(--radius-large);
    border-bottom-right-radius: var(--radius-large);
    padding: 8px;
    color: var(--color-text);
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/KitchenXR/Presentation/UI/Fonts/NotoSansJP-Regular%20UITK.asset?fileID=11400000&guid=2c70aed3703fdc543b76fb0e36c8518b&type=2#NotoSansJP-Regular%20UITK");
}

/* タイマーの鳴っている板（点滅。C# が付け外しする）。 */
.root-panel--alarm {
    background-color: var(--color-alarm-bg);
}

/*
 * 文字の型の余白をゼロにする。
 *
 * Unity 既定の runtime テーマ（UnityDefaultRuntimeTheme）は Label に padding 上下 4px・
 * margin 上 4px 下 2px（＝合わせて 14px ≒ 2.8cm）を入れる。これは 1 UI px = 1 画面 px の
 * 普通の UI 向けの値で、1 UI px ≒ 2mm のこの板では文字より余白のほうが大きい——本文 6px の
 * Label が 23px を占め、行間が空いて1画面に収まらなくなる。
 *
 * 余白は各板の USS で必要な場所にだけ明示する（margin を書いた側が後勝ちで効く）。
 */
.heading {
    font-size: var(--font-size-heading);
    color: var(--color-text);
    white-space: normal;
    margin: 0px;
    padding: 0px;
}

.body-text {
    font-size: var(--font-size-body);
    color: var(--color-text);
    white-space: normal;
    margin: 0px;
    padding: 0px;
}

.caption {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    white-space: normal;
    margin: 0px;
    padding: 0px;
}

.caption--dim {
    opacity: 0.6;
}

.is-hidden {
    display: none;
}

.divider {
    height: 0.6px;
    background-color: var(--color-divider);
    margin-top: var(--gap-tight);
    margin-bottom: var(--gap-tight);
}

/* --- ボタン（最小4cm角・間隔2cm・押し込みの見た目は hysteresis を反映） --- */

.kitchen-button {
    min-width: var(--button-min);
    min-height: var(--button-min);
    /* 既定テーマの Button の余白も落とす。落とさないと 20px（4cm）のつもりの釦が
     * 29px（5.8cm）になり、板の縦を無駄に食う（上の Label と同じ話）。
     * 横だけは字が縁に付かないよう 4px 残す。 */
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 4px;
    padding-right: 4px;
    margin-left: var(--gap-tight);
    margin-right: var(--gap-tight);
    margin-top: var(--gap-tight);
    margin-bottom: var(--gap-tight);
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    border-width: 0;
    -unity-text-align: middle-center;
    font-size: var(--font-size-body);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.kitchen-button--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
}

.kitchen-button--primary:hover {
    opacity: 0.92;
}

/* poke の「入り」で少し縮む・色を濃くする（hysteresis の見た目）。抜けで戻る。 */
.kitchen-button--pressed {
    scale: 0.94 0.94;
    opacity: 0.8;
}

.kitchen-button--secondary {
    background-color: var(--color-chip-bg);
    color: var(--color-text);
}

.kitchen-button--secondary:hover {
    background-color: rgba(31, 41, 55, 0.14);
}

.kitchen-button--disabled {
    opacity: 0.35;
}

/* 2度押しの1度目（TwoPressButton が付け外しする。取り消せない操作だけ）。 */
.kitchen-button--armed {
    background-color: var(--color-alarm-bg);
    color: var(--color-alarm);
}

/* --- 工程の点列（phase の数ではなく「工程の数だけ」出す） --- */

.step-dots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: var(--gap-tight);
    margin-bottom: var(--gap-tight);
}

.step-dot {
    width: 6px;
    height: 6px;
    margin-left: 2px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: var(--color-chip-bg);
}

/* 済んだ工程。 */
.step-dot--done {
    background-color: var(--color-accent);
}

/* 今の工程。 */
.step-dot--current {
    background-color: var(--color-accent);
    scale: 1.5 1.5;
}

/* phase の変わり目は間隔で見せる（色の段は上の3つと兼ねる）。 */
.step-dot--phase-start {
    margin-left: 8px;
}

/* --- 材料の板（横スクロール禁止・文字を一段小さく・行の高さを板の幅に合わせる） --- */

/*
 * 行を 8px（1.6cm）に詰め、行間（margin）を無くしてある。板が 170×240 あるので、
 * 20 点程度の材料でもスクロールせずに全部見える（PanelLayoutTests で検算）。
 *
 * 「最小4cm角」は押す釦の話で、ここは当てない——材料のチェックは押し損ねても調理が
 * 進まないだけの見た目であり、一目で全部見えることのほうが効く。
 * 押す的は行の全幅（板の幅いっぱい）なので狙い自体は難しくない。
 */
.ingredient-row {
    flex-direction: row;
    align-items: center;
    min-height: 8px;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 0.5px;
    padding-bottom: 0.5px;
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    margin-bottom: 0px;
    overflow: hidden;
    flex-shrink: 0;
}

.ingredient-row--highlight {
    background-color: var(--color-chip-bg-strong);
}

/* 行を 8px に詰めたので、印も一回り小さくする（8px だと印だけで行が膨らむ）。 */
.ingredient-row__check {
    width: 6px;
    height: 6px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--color-text-muted);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
}

.ingredient-row__check--checked {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
}

.ingredient-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--font-size-ingredient);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0px;
    padding: 0px;
}

.ingredient-row__qty {
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    margin: 0px;
    margin-left: 4px;
    padding: 0px;
    flex-shrink: 0;
    white-space: nowrap;
    overflow: hidden;
}

.ingredient-row--checked .ingredient-row__name {
    color: var(--color-text-muted);
}

/* --- タイマー --- */

.timer-card {
    background-color: rgba(31, 41, 55, 0.05);
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    padding: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.timer-card--alarm {
    background-color: var(--color-alarm-bg);
}

.timer-value {
    font-size: 14px;
    color: var(--color-text);
    -unity-text-align: middle-left;
    min-width: 42px;
}

.timer-value--running {
    color: var(--color-accent);
}

.timer-value--elapsed {
    color: var(--color-alarm);
}
