/*
 * KitchenXR 共通テーマ（設計 Docs/design/PROTOTYPE.md §9・§11 追補）。
 * 白 85% の半透明の板・濃灰の文字・琥珀の強調色1色。角丸は大きめ。Unity既定の見た目は使わない。
 *
 * 実寸の換算:
 *   ワールド空間パネルは PanelSettings の World Space モード（Pixels Per Unit = 100）で、
 *   板の GameObject の localScale を 0.2 にそろえている。
 *   つまり 1 UI px = (1/100) local unit × 0.2 = 2mm。20px = 4cm・10px = 2cm。
 *   設計 §7 の「最小4cm角・間隔2cm」はこの換算で決めた数値。
 *
 * 注意（2026-09-12 の実機不具合の直し。同じ罠を踏まないこと）:
 *   1) `-unity-font-definition` は **UnityEngine.TextCore.Text.FontAsset**（UI Toolkit 用）しか
 *      受け付けない。`Assets/TextMesh Pro/.../*.asset` は TMPro.TMP_FontAsset なので型が合わず、
 *      指定ごと無視されて文字が1つも描かれなかった。ここでは
 *      `Assets/KitchenXR/Presentation/UI/Fonts/NotoSansJP-Regular UITK.asset`
 *      （KitchenFontAssetBuilder が TTF から作る TextCore 版）を指す。
 *   2) 長さは **必ず単位（px）を付ける**。`--font-size-heading: 10` のような単位無しの値は
 *      `var()` 越しに `font-size` へ渡すと型が合わず無視され、既定の 14px に戻ってしまう。
 */

:root {
    --color-panel-bg: rgba(255, 255, 255, 0.85);
    --color-text: rgb(31, 41, 55);
    --color-text-muted: rgba(31, 41, 55, 0.55);
    --color-accent: rgb(245, 158, 11);
    --color-accent-text: rgb(255, 255, 255);
    --color-divider: rgba(31, 41, 55, 0.15);
    --color-chip-bg: rgba(31, 41, 55, 0.08);
    --color-chip-bg-strong: rgba(245, 158, 11, 0.18);
    --color-alarm: rgb(220, 38, 38);
    --color-alarm-bg: rgba(220, 38, 38, 0.22);

    /* 文字3段（見出し／本文／補助）。48/32/24pt の比を保った実機換算値（上のコメント参照）。
     * 2026-09-13 主人「少し大きいかも」——**本文だけ**1段下げた（7px ≒ 32pt → 6px ≒ 27pt）。
     * 見出しと補助は据え置き。材料の板はさらに一段小さい --font-size-ingredient を使う（§11 追補）。 */
    --font-size-heading: 10px;
    --font-size-body: 6px;
    --font-size-caption: 5px;
    --font-size-ingredient: 5.5px;

    --radius-large: 12px;
    --radius-medium: 6px;

    /* ボタン: 最小4cm角 = 20px、間隔2cm = 10px（設計 §7）。
     * ボタンの余白は上下左右 5px（＝隣り合うボタンの間が 10px = 2cm）。
     * v1.0.2 は 10px（間隔 4cm）で、本文の置き場を圧迫していた（§11 追補「本文が重ならない」）。 */
    --button-min: 20px;
    --gap-loose: 10px;
    --gap-tight: 5px;
}

.root-panel {
    flex-grow: 1;
    background-color: var(--color-panel-bg);
    border-top-left-radius: var(--radius-large);
    border-top-right-radius: var(--radius-large);
    border-bottom-left-radius: var(--radius-large);
    border-bottom-right-radius: var(--radius-large);
    padding: 8px;
    color: var(--color-text);
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/KitchenXR/Presentation/UI/Fonts/NotoSansJP-Regular%20UITK.asset?fileID=11400000&guid=2c70aed3703fdc543b76fb0e36c8518b&type=2#NotoSansJP-Regular%20UITK");
}

/* タイマーの鳴っている板（点滅。C# が付け外しする）。 */
.root-panel--alarm {
    background-color: var(--color-alarm-bg);
}

.heading {
    font-size: var(--font-size-heading);
    color: var(--color-text);
    white-space: normal;
}

.body-text {
    font-size: var(--font-size-body);
    color: var(--color-text);
    white-space: normal;
}

.caption {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    white-space: normal;
}

.caption--dim {
    opacity: 0.6;
}

.is-hidden {
    display: none;
}

.divider {
    height: 0.6px;
    background-color: var(--color-divider);
    margin-top: var(--gap-tight);
    margin-bottom: var(--gap-tight);
}

/* --- ボタン（設計 §7: 最小4cm角・間隔2cm・押し込みの見た目は hysteresis を反映） --- */

.kitchen-button {
    min-width: var(--button-min);
    min-height: var(--button-min);
    margin-left: var(--gap-tight);
    margin-right: var(--gap-tight);
    margin-top: var(--gap-tight);
    margin-bottom: var(--gap-tight);
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    border-width: 0;
    -unity-text-align: middle-center;
    font-size: var(--font-size-body);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.kitchen-button--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
}

.kitchen-button--primary:hover {
    opacity: 0.92;
}

/* poke の「入り」で少し縮む・色を濃くする（hysteresis の見た目）。抜けで戻る。 */
.kitchen-button--pressed {
    scale: 0.94 0.94;
    opacity: 0.8;
}

.kitchen-button--secondary {
    background-color: var(--color-chip-bg);
    color: var(--color-text);
}

.kitchen-button--secondary:hover {
    background-color: rgba(31, 41, 55, 0.14);
}

.kitchen-button--disabled {
    opacity: 0.35;
}

/* --- 工程の点列（設計 §11 追補: phase の3つではなく「工程の数だけ」出す） --- */

.step-dots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: var(--gap-tight);
    margin-bottom: var(--gap-tight);
}

.step-dot {
    width: 6px;
    height: 6px;
    margin-left: 2px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: var(--color-chip-bg);
}

/* 済んだ工程。 */
.step-dot--done {
    background-color: var(--color-accent);
}

/* 今の工程。 */
.step-dot--current {
    background-color: var(--color-accent);
    scale: 1.5 1.5;
}

/* phase の変わり目は間隔で見せる（色の段は上の3つと兼ねる）。 */
.step-dot--phase-start {
    margin-left: 8px;
}

/* --- 材料の板（§11 追補: 横スクロール禁止・文字を一段小さく・行の高さを板の幅に合わせる） --- */

.ingredient-row {
    flex-direction: row;
    align-items: center;
    min-height: 12px;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    margin-bottom: 1px;
    overflow: hidden;
    flex-shrink: 0;
}

.ingredient-row--highlight {
    background-color: var(--color-chip-bg-strong);
}

.ingredient-row__check {
    width: 8px;
    height: 8px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--color-text-muted);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
}

.ingredient-row__check--checked {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
}

.ingredient-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--font-size-ingredient);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ingredient-row__qty {
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    margin-left: 4px;
    flex-shrink: 0;
    white-space: nowrap;
    overflow: hidden;
}

.ingredient-row--checked .ingredient-row__name {
    color: var(--color-text-muted);
}

/* --- タイマー --- */

.timer-card {
    background-color: rgba(31, 41, 55, 0.05);
    border-top-left-radius: var(--radius-medium);
    border-top-right-radius: var(--radius-medium);
    border-bottom-left-radius: var(--radius-medium);
    border-bottom-right-radius: var(--radius-medium);
    padding: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.timer-card--alarm {
    background-color: var(--color-alarm-bg);
}

.timer-value {
    font-size: 14px;
    color: var(--color-text);
    -unity-text-align: middle-left;
    min-width: 42px;
}

.timer-value--running {
    color: var(--color-accent);
}

.timer-value--elapsed {
    color: var(--color-alarm);
}
