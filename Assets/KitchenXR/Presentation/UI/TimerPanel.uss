/*
 * タイマーの板（調理中は常時使える）。
 * 上に「新しいタイマー」の作り口（任意の長さ・1/3/5/10分・±30秒）、下に動いているものを縦に積む。
 */

.timer-setter {
    flex-shrink: 0;
}

.timer-setter__label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.timer-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.timer-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.timer-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.timer-card__title {
    margin-bottom: 1px;
    overflow: hidden;
}
