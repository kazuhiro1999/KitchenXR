  "steps": [
    {
      "index": 1,
      "phase": "prep",
      "title": "豚肉を刻む",
      "instruction": "豚バラを粗みじん切りにし、塩ひとつまみをふる。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/f6/f6dd7349cff5bbb134b53af77d68d916.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "豚バラ薄切り肉"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": [
        "ベーコンでも可。その場合は塩を小さじ1/4に減らす",
        "かまぼこ・カニかまでも可"
      ]
    },
    {
      "index": 2,
      "phase": "prep",
      "title": "ねぎとしょうがを刻む",
      "instruction": "長ねぎは粗みじん切り、しょうがはみじん切りにする。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/f6/f6dd7349cff5bbb134b53af77d68d916.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "長ねぎ",
        "しょうが"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": []
    },
    {
      "index": 3,
      "phase": "prep",
      "title": "卵を溶く",
      "instruction": "卵3個を割りほぐす。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/f6/f6dd7349cff5bbb134b53af77d68d916.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "卵"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": []
    },
    {
      "index": 4,
      "phase": "cook",
      "title": "肉とねぎを焼く",
      "instruction": "油はひかず、豚肉と長ねぎの半量を強めの中火で焼く。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/30/30e93f4891fc532d47e57f3eaed2fd6f.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "豚バラ薄切り肉",
        "長ねぎ"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": []
    },
    {
      "index": 5,
      "phase": "cook",
      "title": "香りを出す",
      "instruction": "ねぎに焦げ目がついたら弱めの中火。具を端に寄せ、油としょうがを入れて傾けて炒める。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/14/14e7678937e9354953d640d64b41147f.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "サラダ油",
        "しょうが"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": [
        "香りが立つまで火を通す"
      ]
    },
    {
      "index": 6,
      "phase": "cook",
      "title": "卵とご飯を入れる",
      "instruction": "強めの中火。油の上に卵液を流し、ご飯をのせて木べらで全体を混ぜる。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/66/66e94611af2fd7297cebc92b94966f48.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "卵",
        "ご飯"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": [
        "パラパラのコツ: 油を多めに、熱した油に卵を流し、すぐご飯を入れて炒める"
      ]
    },
    {
      "index": 7,
      "phase": "cook",
      "title": "調味料Aを入れる",
      "instruction": "Aを加え、パラッとするまで炒め合わせる。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/51/51dab3086e3a71399cd145a19f59e887.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "鶏ガラスープの素",
        "塩",
        "にんにくチューブ",
        "粗挽き黒胡椒",
        "砂糖"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": []
    },
    {
      "index": 8,
      "phase": "finish",
      "title": "ねぎとしょうゆ",
      "instruction": "残りのねぎを加え、しょうゆを縁から回し入れてザッと炒め、火を止める。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/df/df50f263f10767db37479ddd3ed9b9b7.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "長ねぎ",
        "しょうゆ"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": []
    },
    {
      "index": 9,
      "phase": "finish",
      "title": "味を調える",
      "instruction": "必要なら塩少々で調え、ごま油をたらして混ぜる。",
      "image": "https://asset.oceans-nadia.com/upload/save_image/df/df50f263f10767db37479ddd3ed9b9b7.jpeg?impolicy=cropwm&w=600&h=600",
      "ingredients_used": [
        "ごま油"
      ],
      "timer_sec": null,
      "completion": "manual",
      "tips": [
        "冷蔵で翌日まで。1食ずつ包んで冷凍なら約3週間"
      ]
    }
  ]
}
